# HarmonyHub configuration — copy to `.env` (repo root) and fill in the blanks.
# The backend, Prisma, docker compose, and the Python recommender all read this file.

# --- Spotify (https://developer.spotify.com/dashboard) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Google Gemini (AI playlists) ---
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash

# --- Backend ---
PORT=3000
CORS_ORIGIN=http://localhost:5173
# Lifetime of a party room and all of its data, in seconds (default 24h)
ROOM_TTL_SECONDS=86400

# --- Postgres (docker compose) ---
POSTGRES_USER=harmonyhub
POSTGRES_PASSWORD=harmonyhub
POSTGRES_DB=harmonyhub
# Host port; change it if something else (e.g. a local Postgres) already uses 5432
POSTGRES_PORT=5432
DATABASE_URL=postgresql://harmonyhub:harmonyhub@localhost:5432/harmonyhub?schema=public

# --- Redis (docker compose) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Python recommender ---
PYTHON_RECOMMENDER_HOST=127.0.0.1
PYTHON_RECOMMENDER_PORT=5001
PYTHON_RECOMMENDER_URL=http://127.0.0.1:5001
